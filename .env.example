# --- Database -------------------------------------------------------------
# SQLite by default (works offline, zero ops). For Postgres see README ADR-002.
DATABASE_URL="file:./dev.db"

# --- AI -------------------------------------------------------------------
# Set AI_API_KEY to enable live AI. Leave unset to use the built-in demo mode,
# or set AI_MOCK=1 to force deterministic output (tests / CI / screenshots).
AI_PROVIDER="openai"          # openai | anthropic | google
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_MOCK="1"
AI_RATE_LIMIT_PER_MIN="10"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional shared passcode. Leave empty to disable the gate entirely.
APP_PASSCODE=""
